---
import Base from '../../layouts/Base.astro';
import TermScale from '../../components/TermScale.astro';
import CarCard from '../../components/CarCard.astro';
import { cars, programNames, rub } from '../../data/cars.js';
import { site } from '../../data/site.js';
import { u } from '../../lib/url.js';

export function getStaticPaths() {
  return cars.map((car) => ({ params: { slug: car.slug }, props: { car } }));
}
const { car } = Astro.props;
const main = car.programs[0];
const cta = { rent: 'Забронировать', taxi: 'Узнать, свободна ли машина', buyout: 'Получить расчёт выкупа' }[main];
const sectionHref = { rent: '/prokat/', taxi: '/taxi/', buyout: '/vykup/' }[main];
const others = cars.filter((c) => c.slug !== car.slug && c.programs.some((p) => car.programs.includes(p))).slice(0, 3);
const title = `${car.name}${car.year ? ' ' + car.year : ''}: ${car.programs.map((p) => programNames[p].toLowerCase()).join(', ')} — ${car.city}`;
---
<Base title={title} description={car.short}>
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Навигация"><a href={u('/')}>Главная</a> / <a href={u('/avtopark/')}>Автопарк</a> / {car.name}</nav>
  </div>
  <section class="wrap car">
    <div class="gal" data-gallery>
      <img class="gal__main" data-main src={u(car.photos[0])} alt={`${car.name}${car.year ? ' ' + car.year : ''}`} width="1280" height="960" />
      <div class="gal__thumbs">
        {car.photos.map((p, i) => (
          <button type="button" class="gal__thumb" data-thumb data-src={u(p)} aria-current={String(i === 0)} aria-label={`Фото ${i + 1}`}>
            <img src={u(p)} alt="" width="160" height="120" loading="lazy" />
          </button>
        ))}
      </div>
    </div>

    <div class="car__info">
      <p class="car__progs">{car.programs.map((p) => <span class="chip">{programNames[p]}</span>)} <span class="chip">{car.city}</span></p>
      <h1 class="car__name"><span class="slant">{car.name}</span></h1>
      <p class="car__sub">{[car.body, car.year].filter(Boolean).join(', ')}</p>
      <p class="car__short">{car.short}</p>

      {car.scale ? (
        <div class="car__scale"><TermScale scale={car.scale} /></div>
      ) : (
        <p class="car__price"><span class="price">{rub(car.priceFrom)}</span> <span class="muted">в сутки</span></p>
      )}
      {car.promo && <p class="car__promo">{car.promo}</p>}

      <div class="car__btns">
        <button class="btn btn--taxi" type="button" data-open-lead data-service={main} data-car={car.slug}>{cta}</button>
        <a class="btn btn--line" href={site.phoneHref}>Позвонить</a>
      </div>
    </div>
  </section>

  <section class="wrap car__details">
    <div>
      <h2>Характеристики</h2>
      <dl class="tbl">{car.specs.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
    </div>
    <div>
      <h2>Условия</h2>
      <dl class="tbl">{car.terms.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
      {car.features?.length > 0 && (
        <>
          <h3 class="car__feat-h">Что есть в машине</h3>
          <ul class="car__feat">{car.features.map((f) => <li>{f}</li>)}</ul>
        </>
      )}
      <p class="muted car__note">Суммы предварительные. Точные условия, график платежей и порядок выкупа закрепляются в договоре. <a href={u(sectionHref)}>Все условия раздела</a></p>
    </div>
  </section>

  {others.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2>Похожие машины</h2>
        <div class="car__others">{others.map((c) => <CarCard car={c} />)}</div>
      </div>
    </section>
  )}
</Base>

<style>
  .car { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: start; padding-bottom: 48px; }
  .gal { min-width: 0; }
  .gal__main { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 4px; background: #cfd1cf; }
  .gal__thumbs { display: flex; gap: 8px; overflow-x: auto; margin-top: 10px; padding-bottom: 4px; }
  .gal__thumb { flex: none; width: 96px; padding: 0; border: 2px solid transparent; border-radius: 4px; background: none; cursor: pointer; overflow: hidden; }
  .gal__thumb img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .gal__thumb[aria-current='true'] { border-color: var(--graphite); }
  .car__info { min-width: 0; }
  .car__progs { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 14px; }
  .car__name { font-size: clamp(30px, 4.2vw, 50px); margin-bottom: 4px; }
  .car__sub { color: var(--asphalt); margin-bottom: 14px; }
  .car__short { font-size: 18px; }
  .car__scale { background: var(--white); border-radius: 8px; padding: 22px; margin: 22px 0 8px; }
  .car__price { margin: 18px 0 6px; }
  .car__price .price { font-size: clamp(34px, 5vw, 48px); }
  .car__promo { background: var(--graphite); color: var(--white); display: inline-block; padding: 8px 12px; border-radius: 4px; margin: 6px 0 0; }
  .car__btns { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 22px; }
  .car__details { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 4vw, 56px); padding-top: 24px; border-top: 1px solid var(--line); }
  .car__details h2 { font-size: 26px; }
  .tbl { display: grid; grid-template-columns: minmax(120px, 42%) 1fr; margin: 0 0 24px; }
  .tbl dt, .tbl dd { padding: 10px 0; border-bottom: 1px solid var(--line); margin: 0; }
  .tbl dt { color: var(--asphalt); padding-right: 16px; }
  .car__feat-h { margin-top: 8px; }
  .car__feat { padding-left: 20px; margin: 0 0 20px; }
  .car__feat li { margin-bottom: 4px; }
  .car__note { font-size: 14px; }
  .car__others { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr)); gap: 20px; }
  @media (max-width: 900px) { .car, .car__details { grid-template-columns: 1fr; } }
</style>
