---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Contacts from '../components/Contacts.astro';
import { site } from '../data/site.js';
---
<Base title="Контакты" description="MONTANA group: Москва, Нахимовский проспект, 24. Ежедневно с 10:00 до 22:00.">
  <PageHead title="Контакты" lead={`${site.address}. ${site.hours}.`} />
  <Contacts />
  <section class="map">
    <iframe title="Карта: Нахимовский проспект, 24" src="https://yandex.ru/map-widget/v1/?text=%D0%9C%D0%BE%D1%81%D0%BA%D0%B2%D0%B0%2C%20%D0%9D%D0%B0%D1%85%D0%B8%D0%BC%D0%BE%D0%B2%D1%81%D0%BA%D0%B8%D0%B9%20%D0%BF%D1%80%D0%BE%D1%81%D0%BF%D0%B5%D0%BA%D1%82%2C%2024&z=16" loading="lazy" width="100%" height="420"></iframe>
  </section>
</Base>
<style>
  .map iframe { display: block; border: 0; width: 100%; height: 420px; background: #d8dad7; }
</style>
