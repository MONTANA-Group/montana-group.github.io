---
import { u } from '../lib/url.js';
const { title, lead, crumb } = Astro.props;
---
<section class="ph">
  <div class="wrap">
    <nav class="breadcrumbs" aria-label="Навигация"><a href={u('/')}>Главная</a> / {crumb || title}</nav>
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
<style>
  .ph { background: var(--white); padding-bottom: clamp(28px, 5vw, 48px); border-bottom: 1px solid var(--line); }
  .ph h1 { max-width: 20ch; }
</style>
