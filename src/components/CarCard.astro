---
import { programNames, rub } from '../data/cars.js';
import { u } from '../lib/url.js';
const { car } = Astro.props;
const meta = [car.year, car.specs.find(([k]) => k === 'Двигатель')?.[1], car.tariff && `тариф «${car.tariff}»`].filter(Boolean).join(', ');
---
<a class="card" href={u(`/cars/${car.slug}/`)} data-programs={car.programs.join(' ')} data-city={car.city}>
  <div class="card__img">
    <img src={u(car.photos[0])} alt={`${car.name}${car.year ? ' ' + car.year : ''}`} width="640" height="480" loading="lazy" />
    {car.city !== 'Москва' && <span class="card__city">{car.city}</span>}
  </div>
  <div class="card__body">
    <h3 class="card__name"><span class="slant">{car.name}</span></h3>
    <p class="card__meta">{meta}</p>
    <div class="card__foot">
      <span class="price"><span class="card__mark">от {rub(car.priceFrom)}</span><small>/ {car.unit}</small></span>
      <span class="card__progs">{car.programs.map((p) => <span class="chip">{programNames[p]}</span>)}</span>
    </div>
  </div>
</a>

<style>
  .card { display: flex; flex-direction: column; text-decoration: none; background: var(--white); border-radius: 4px; overflow: hidden; min-width: 0; }
  .card[hidden] { display: none; }
  .card__img { position: relative; aspect-ratio: 4 / 3; background: #cfd1cf; }
  .card__img img { width: 100%; height: 100%; object-fit: cover; }
  .card__city { position: absolute; left: 12px; top: 12px; background: var(--graphite); color: var(--white); font-size: 13px; padding: 5px 9px; border-radius: 4px; }
  .card__body { padding: 18px 18px 20px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .card__name { font-size: 21px; margin: 0; }
  .card:hover .card__name .slant { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .card__meta { color: var(--asphalt); font-size: 15px; margin: 0; }
  .card__foot { margin-top: auto; padding-top: 14px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px; }
  .card__foot .price { font-size: 20px; }
  .card__mark { box-shadow: inset 0 -.38em 0 var(--taxi); padding: 0 2px; }
  .card__progs { display: flex; gap: 6px; flex-wrap: wrap; }
</style>
